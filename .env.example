# Banco de dados PostgreSQL
POSTGRES_DB=codereview
DB_USER=codereview
DB_PASSWORD=TROQUE_POR_SENHA_FORTE
DATABASE_URL=jdbc:postgresql://localhost:5432/codereview

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=codereview
RABBITMQ_PASSWORD=TROQUE_POR_SENHA_FORTE

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ollama (LLM local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# JWT (gere com: openssl rand -hex 64)
JWT_SECRET=TROQUE_POR_CHAVE_ALEATORIA_256BITS
JWT_EXPIRATION_MS=86400000

# GitHub (opcional: para busca de PRs)
GITHUB_TOKEN=ghp_seu_token_aqui

# Aplicação
APP_PORT=8080
APP_ENV=dev

# CORS (deny-by-default). Liste origens permitidas separadas por vírgula.
# Vazio = nenhuma origem cross-site aceita.
SECURITY_CORS_ALLOWED_ORIGINS=

# OWASP Dependency-Check (opcional): acelera o download da base NVD
NVD_API_KEY=
